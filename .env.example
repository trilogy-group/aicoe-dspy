# DSPy Structured Output Explorer - Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI Configuration (for GPT-4, GPT-3.5, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here  # Optional

# Anthropic Configuration (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI Configuration (for Gemini models)  
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Configuration (for Grok models)
XAI_API_KEY=your_xai_api_key_here

# Configuration Options
DEFAULT_MODEL=openai/gpt-4  # Default model to use
ENABLE_CACHING=false        # Enable response caching
MAX_RETRIES=3              # Maximum API call retries
TIMEOUT_SECONDS=30         # API call timeout

# Logging Configuration
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR
LOG_FILE=dspy_explorer.log # Log file path (optional)

# Demo Configuration
DEMO_MODE=interactive      # batch, interactive, or minimal
OUTPUT_FORMAT=json         # json, yaml, or table
SAVE_RESULTS=true         # Save demo results to file